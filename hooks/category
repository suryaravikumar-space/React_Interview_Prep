# Hooks Category
state  -- useState, useReducer, useActionState(New React 19)
context -- useContext, use (New)
Ref     -- useRef, useImperactiveHandle
Effect  -- useEffect, useLayoutEffect, useInsertionEffect
Performance  -- useMemo, useCallback, useTransition, userDifferedValue
other  -- useId, userOptitmitic (new, useFormStatus(new), useSyncExternalState, useDebugValue
